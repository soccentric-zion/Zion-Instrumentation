[Unit]
Description=Arches Instrumentation telemetry
Documentation=file:///usr/share/doc/instrumentation/interface.md
After=instr-istate.service instr-faults.service instr-monitord.service instr-hardware.service
Wants=instr-istate.service instr-faults.service instr-monitord.service instr-hardware.service
# istate owns orchestration; systemd owns restart policy and sandboxing (§7.1).

[Service]
Type=notify
ExecStart=/usr/bin/instr-telemetry
Restart=on-failure
RestartSec=2s
ReadWritePaths=/run/instrumentation
User=instr-telemetry
Group=instr
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
ProtectHome=yes
CapabilityBoundingSet=
LimitNOFILE=2048
MemoryMax=64M

[Install]
WantedBy=multi-user.target

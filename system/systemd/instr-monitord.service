[Unit]
Description=Arches Instrumentation monitord
Documentation=file:///usr/share/doc/instrumentation/interface.md
After=instr-istate.service
Wants=instr-istate.service
# istate owns orchestration; systemd owns restart policy and sandboxing (§7.1).

[Service]
Type=notify
ExecStart=/usr/bin/instr-monitord
Restart=on-failure
RestartSec=2s
ReadWritePaths=/run/instrumentation
User=instr-monitord
Group=instr
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
ProtectHome=yes
CapabilityBoundingSet=
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target

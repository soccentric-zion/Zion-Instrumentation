[Unit]
Description=Arches Instrumentation faults
Documentation=file:///usr/share/doc/instrumentation/interface.md
After=instr-istate.service
Wants=instr-istate.service
# istate owns orchestration; systemd owns restart policy and sandboxing (§7.1).

[Service]
Type=notify
ExecStart=/usr/bin/instr-faults
Restart=on-failure
RestartSec=2s
# Read-only observer (R6): no write access beyond /run.
ReadOnlyPaths=/var/log /proc
ReadWritePaths=/run/instrumentation
User=instr-faults
Group=instr
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
ProtectHome=yes
CapabilityBoundingSet=
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target

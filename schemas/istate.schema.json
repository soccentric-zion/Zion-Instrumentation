{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arches.soccentric.com/schemas/istate.schema.json",
  "title": "istate configuration (REQ \u00a77.1)",
  "description": "Validated at load; a typo is a loud rejection, never a silent behavioural change (REQ \u00a79).",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Daemon enabled."
    },
    "log_level": {
      "type": "string",
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "description": "Runtime log level for this daemon (\u00a74)."
    },
    "time_source_priority": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gnss",
          "ptp",
          "ntp"
        ]
      },
      "minItems": 1,
      "description": "Locked priority order GNSS > PTP > NTP (\u00a77.1)."
    },
    "ntp_servers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ptp_domain": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "ptp_profile": {
      "type": "string"
    },
    "gnss_constellations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gps",
          "galileo",
          "glonass",
          "beidou",
          "qzss"
        ]
      }
    },
    "hq_endpoint": {
      "type": "string",
      "description": "host:port of the HQ peer over the tunnel."
    },
    "liveness_hang_timeout_s": {
      "type": "number",
      "minimum": 1
    },
    "spool_max_bytes": {
      "type": "integer",
      "minimum": 4096
    },
    "budget_spool_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "budget_logs_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "budget_ota_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "budget_backup_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "watchdog_timeout_s": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false
}

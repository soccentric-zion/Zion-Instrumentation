{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arches.soccentric.com/schemas/telemetry.schema.json",
  "title": "telemetry configuration (REQ \u00a77.8)",
  "description": "Validated at load; a typo is a loud rejection, never a silent behavioural change (REQ \u00a79).",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Daemon enabled."
    },
    "log_level": {
      "type": "string",
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "description": "Runtime log level for this daemon (\u00a74)."
    },
    "interval": {
      "type": "number",
      "minimum": 0.1,
      "description": "Send interval (s)."
    },
    "batch_max_records": {
      "type": "integer",
      "minimum": 1
    },
    "aggregation_window_s": {
      "type": "number",
      "minimum": 0
    },
    "retention_batches": {
      "type": "integer",
      "minimum": 0,
      "description": "Bounded local retention of unsent data; oldest dropped first (\u00a77.8)."
    },
    "health_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "monitord",
          "hardware",
          "faults",
          "alarms"
        ]
      }
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false
}
